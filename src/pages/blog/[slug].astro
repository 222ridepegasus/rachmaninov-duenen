---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug }, // single string
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const fmt = (d: Date | string) =>
  (d instanceof Date ? d : new Date(d)).toLocaleDateString("en-GB", {
    year: "numeric", month: "long", day: "numeric",
  });
---
<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article class="mx-auto max-w-[760px] px-5 sm:px-8 py-10">
    {post.data.cover && (
      <img
        src={post.data.cover as string}
        alt={post.data.coverAlt ?? ""}
        class="block w-full h-auto rounded-lg mb-8"
      />
    )}
    <h1 class="text-4xl font-extrabold">{post.data.title}</h1>
    <p class="mt-2 text-sm text-gray-500">{fmt(post.data.date)}</p>
    <div class="prose dark:prose-invert mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>