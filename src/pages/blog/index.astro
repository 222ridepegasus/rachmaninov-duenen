---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => {
    const da = a.data.date instanceof Date ? a.data.date : new Date(a.data.date as any);
    const db = b.data.date instanceof Date ? b.data.date : new Date(b.data.date as any);
    return db.getTime() - da.getTime();
  });

const fmt = (d: Date | string) =>
  (d instanceof Date ? d : new Date(d)).toLocaleDateString("en-GB", {
    year: "numeric", month: "short", day: "numeric",
  });
---
<BaseLayout title="Blog">
  <main class="mx-auto max-w-[1200px] px-5 sm:px-8 py-10">
    <h1 class="text-3xl font-extrabold mb-6">Blog</h1>

    {posts.length === 0 ? (
      <p class="text-gray-500">No posts yet.</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((p) => (
          <li class="group">
            {p.data.cover && (
              <div class="relative w-full overflow-hidden rounded-lg aspect-[16/9]">
                <img
                  src={p.data.cover as string}
                  alt={p.data.coverAlt ?? ""}
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
            <a href={`/blog/${p.slug}/`} class="mt-3 block">
              <h2 class="text-lg font-bold group-hover:text-kk-pink transition-colors">
                {p.data.title}
              </h2>
              <p class="mt-1 text-sm text-gray-500">{fmt(p.data.date)}</p>
              {p.data.excerpt && <p class="mt-2 text-gray-600">{p.data.excerpt}</p>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>