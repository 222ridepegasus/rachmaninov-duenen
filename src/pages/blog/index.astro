---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .map((post) => {
    const wordCount = post.body.split(/\s+/).length;
    const readTime = Math.max(1, Math.ceil(wordCount / 225));
    return {
      ...post,
      data: {
        ...post.data,
        readTime,
      },
    };
  })
  .sort((a, b) => {
    const da = a.data.date instanceof Date ? a.data.date : new Date(a.data.date as any);
    const db = b.data.date instanceof Date ? b.data.date : new Date(b.data.date as any);
    return db.getTime() - da.getTime();
  });

const fmt = (d: Date | string) =>
  (d instanceof Date ? d : new Date(d)).toLocaleDateString("en-GB", {
    year: "numeric", month: "short", day: "numeric",
  });
---
<BaseLayout title="Blog">
  <main class="mx-auto max-w-[1200px] px-5 sm:px-8 py-10">
    {posts.length === 0 ? (
      <p class="text-gray-500">No posts yet.</p>
    ) : (
      posts.map((p) => (
        <a href={`/blog/${p.slug}/`} class="group grid gap-6 lg:grid-cols-12 items-center mb-14">
          <div class="lg:col-span-7">
            {p.data.cover && (
              <div class="relative w-full overflow-hidden aspect-[16/9]">
                <img
                  src={p.data.cover as string}
                  alt={p.data.coverAlt ?? ""}
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] rounded-none"
                  loading="lazy"
                />
              </div>
            )}
          </div>
          <div class="lg:col-span-5">
            <h2 class="text-3xl sm:text-4xl font-extrabold leading-tight group-hover:text-kk-pink transition-colors">
              {p.data.title}
            </h2>
            <p class="mt-3 text-gray-600 dark:text-gray-300">
              {p.data.excerpt ?? p.data.description}
            </p>
            <p class="mt-3 text-sm text-gray-500">
              {fmt(p.data.date)} · {p.data.readTime} min read
            </p>
          </div>
        </a>
      ))
    )}
  </main>
</BaseLayout>