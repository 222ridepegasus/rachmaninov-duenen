---
const nav = [
  { href: "/", label: "Home" },
  { href: "/blog", label: "Blog" },
  // { href: "/Experimental", label: "Experimental" },
  // { href: "/about", label: "About" },
];

// Grab current path from Astro
const currentPath = Astro.url.pathname;
---


<header data-nav class="sticky top-0 z-50 bg-white dark:bg-kk-black transition-transform duration-300 will-change-transform">
  <nav aria-label="Global" class="mx-auto flex max-w-[1920px] items-center justify-between p-5 pl-4 pr-4 sm:px-12">
    <a href="/" class="-m-1.5 p-1.5">
      <span class="sr-only">Kieran Kelly</span>
      <img src="/kk.svg" alt="" class="w-30 sm:w-36 h-auto" />
    </a>

    <!-- Theme toggle -->
    

    <!-- Mobile hamburger -->
    <div class="flex gap-4 sm:hidden">
      <button
      type="button"
      data-theme-toggle
      class="inline-flex items-center justify-center rounded-lg px-3 text-sm hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring focus-visible:ring-indigo-500/40 text-gray-900 dark:text-gray-100"
      aria-label="Toggle theme"
      title="Toggle theme"
      >
      <!-- Sun in dark mode -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="4" stroke-width="1.5" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-width="1.5" />
      </svg>
      <!-- Moon in light mode -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 block dark:hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
      </svg>
      </button>

      <button
        type="button"
        id="open-mobile-menu"
        class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-gray-700 dark:text-gray-400"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open main menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-8 h-8">
          <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <!-- Desktop nav -->
    <div class="hidden sm:flex sm:gap-x-12">
      {
        nav.map((item) => {
          const isActive = currentPath === item.href;
          const activeClass = isActive ? "text-kk-pink" : "";
          return (
            <a
              href={item.href}
              class={`text-lg font-bold ${activeClass}`}
            >
              {item.label}
            </a>
          );
        })
      }
      <button
      type="button"
      data-theme-toggle
      class="inline-flex items-center justify-center rounded-lg px-3 text-sm hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring focus-visible:ring-indigo-500/40 text-gray-900 dark:text-gray-100"
      aria-label="Toggle theme"
      title="Toggle theme"
      >
      <!-- Sun in dark mode -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <circle cx="12" cy="12" r="4" stroke-width="1.5" />
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-width="1.5" />
      </svg>
      <!-- Moon in light mode -->
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 block dark:hidden" viewBox="0 0 24 24" fill="currentColor">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
      </svg>
      </button>
    </div>
    
  </nav>

  <!-- Mobile menu using native <dialog> (replacing <el-dialog>) -->
  <dialog id="mobile-menu" class="backdrop:bg-transparent sm:hidden">
    <div tabindex="0" class="fixed inset-0 focus:outline-none">
      <!-- Panel (replacing <el-dialog-panel>) -->
      <div class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-white p-5 pl-4 pr-4 sm:max-w-sm sm:ring-1 sm:ring-gray-900/10 dark:bg-gray-900 dark:sm:ring-gray-100/10">
        <div class="flex items-center justify-between">
          <a href="/" class="-m-1.5 p-1.5">
            <span class="sr-only">Kieran Kelly</span>
            <img src="/kk.svg" alt="" class="w-30 sm:w-36 h-auto" />
          </a>
          <div class="flex gap-4">
            <button
            type="button"
            data-theme-toggle
            class="inline-flex items-center justify-center rounded-lg px-3 text-sm hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring focus-visible:ring-indigo-500/40 text-gray-900 dark:text-gray-100"
            aria-label="Toggle theme"
            title="Toggle theme"
            >
            <!-- Sun in dark mode -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="4" stroke-width="1.5" />
                <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-width="1.5" />
            </svg>
            <!-- Moon in light mode -->
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 block dark:hidden" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
            </svg>
            </button>
            <button type="button" id="close-mobile-menu" class="-m-2.5 rounded-md p-2.5 text-gray-700 dark:text-gray-400">
              <span class="sr-only">Close menu</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" class="w-8 h-8">
                <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>

        <div class="mt-32 py-6 flex justify-center items-center flex-col gap-5">
            {
              nav.map((item) => {
                const isActive = currentPath === item.href;
                const activeClass = isActive ? "text-kk-pink" : "";
                return (
                  <a
                    href={item.href}
                    class={`text-2xl font-bold ${activeClass}`}
                  >
                    {item.label}
                  </a>
                );
              })
            }
         </div>
      </div>
    </div>
  </dialog>

  <!-- Tiny JS to replace the old command= API -->
<script is:inline>
  (function () {
    const openBtn = document.getElementById('open-mobile-menu');
    const dialog = document.getElementById('mobile-menu');
    const closeBtn = document.getElementById('close-mobile-menu');
    if (!openBtn || !dialog || !closeBtn) return;

    // Freeze/unfreeze page scroll while the drawer is open
    function lockScroll(lock) {
      if (lock) {
        const y = window.scrollY;
        document.body.style.position = 'fixed';
        document.body.style.top = `-${y}px`;
        document.body.style.left = '0';
        document.body.style.right = '0';
        document.body.style.width = '100%';
      } else {
        const y = parseInt(document.body.style.top || '0', 10) * -1;
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.left = '';
        document.body.style.right = '';
        document.body.style.width = '';
        window.scrollTo(0, y || 0);
      }
    }

    openBtn.addEventListener('click', () => {
      if (dialog.showModal) dialog.showModal();
      else dialog.setAttribute('open', '');
      openBtn.setAttribute('aria-expanded', 'true');
      lockScroll(true); // 🔒 freeze page
    });

    function closeMenu() {
      dialog.close();
      openBtn.setAttribute('aria-expanded', 'false');
      lockScroll(false); // 🔓 unfreeze page
    }

    closeBtn.addEventListener('click', closeMenu);

    // Close when clicking outside the panel
    dialog.addEventListener('click', (e) => {
      const panel = dialog.querySelector('div.fixed.inset-y-0.right-0');
      if (panel && !panel.contains(e.target)) {
        closeMenu();
      }
    });

    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      closeMenu();
    });
  })();
</script>
<script is:inline>
  (function () {
    try {
      const saved = localStorage.getItem("theme");
      const root = document.documentElement;
      if (saved === "dark") root.classList.add("dark");
      else if (saved === "light") root.classList.remove("dark");
    } catch {}

    const root = document.documentElement;

    function setTheme(dark) {
      root.classList.toggle("dark", dark);
      try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
    }

    function handleClick(e) {
      const btn = e.target.closest("[data-theme-toggle]");
      if (!btn) return;
      const willBeDark = !root.classList.contains("dark");
      setTheme(willBeDark);
    }

    document.addEventListener("click", handleClick);
  })();
</script>
<script is:inline>
  (function () {
    const header = document.querySelector('[data-nav]');
    if (!header) return;

    let lastY = window.scrollY;
    let lastTickY = lastY;
    let ticking = false;
    let dir = 0; // +1 down, -1 up
    let locked = false; // pause while drawer/body is locked

    const SHOW_HIDE_THRESHOLD = 16;  // px of movement before toggling
    const STICKY_TOP_GRACE = 64;     // keep visible near the very top

    function update(y) {
      const dy = y - lastTickY;
      lastTickY = y;

      // Always show near top
      if (y <= STICKY_TOP_GRACE) {
        header.classList.remove('-translate-y-full');
        dir = 0;
        return;
      }

      if (dy > 0) {
        // scrolling down
        if (dir >= 0) dir += dy; else dir = dy;
        if (dir > SHOW_HIDE_THRESHOLD) header.classList.add('-translate-y-full');
      } else if (dy < 0) {
        // scrolling up
        const up = -dy;
        if (dir <= 0) dir -= up; else dir = -up;
        if (-dir > SHOW_HIDE_THRESHOLD) header.classList.remove('-translate-y-full');
      }
    }

    function onScroll() {
      if (locked) return;
      lastY = window.scrollY;
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => {
          update(lastY);
          ticking = false;
        });
      }
    }

    // Passive for perf
    window.addEventListener('scroll', onScroll, { passive: true });

    // Reset baseline on unlock / resize / orientation change
    function resetBaseline() {
      lastY = window.scrollY;
      lastTickY = lastY;
    }
    window.addEventListener('resize', resetBaseline, { passive: true });
    window.addEventListener('orientationchange', resetBaseline, { passive: true });

    // Detect drawer open/close (pause while open)
    const dlg = document.getElementById('mobile-menu');
    if (dlg) {
      const mo = new MutationObserver(() => {
        const isOpen = dlg.hasAttribute('open');
        locked = isOpen || document.body.style.position === 'fixed';
        if (isOpen) {
          // Ensure header is visible when the drawer opens
          header.classList.remove('-translate-y-full');
        } else {
          // Re-baseline when it closes
          resetBaseline();
        }
      });
      mo.observe(dlg, { attributes: true, attributeFilter: ['open'] });
    }

    // Also react if body is frozen/unfrozen by other code
    const bodyMo = new MutationObserver(() => {
      const fixed = getComputedStyle(document.body).position === 'fixed';
      locked = fixed;
      if (!fixed) resetBaseline();
    });
    bodyMo.observe(document.body, { attributes: true, attributeFilter: ['style'] });
  })();
</script>
</header>